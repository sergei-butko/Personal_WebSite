node_modules/
.next/
out/
build/

*.log
npm-debug.log*

.DS_Store
*.pem
.vscode/
.idea/

.env*
!.env.example

next-env.d.ts
tsconfig.tsbuildinfo

# Ad-hoc Telegram page dumps; the tracked fixture lives in scripts/__fixtures__/
tg-sample.html

# Image bytes are never committed. They live in Cloudinary, uploaded by the
# sync scripts. This directory was 827 MB of duplicated photos before the
# migration — the ignore keeps a stray local run from putting it back.
/public/images/

# Generated snapshots live in Cloudinary too (data/photos.json,
# data/photo-hashes.json, data/threads.json), so a sync produces no commit and
# main carries no generated content. These paths are ignored so an older
# checkout or a stray script cannot reintroduce them.
src/content/*.generated.ts

# Working copy for `npm run content:pull` / `content:push`. The canonical copy
# is in Cloudinary; this is a scratch checkout of it and must not be committed,
# or the repo would drift from the store the build actually reads.
/content-local/

# Personal working notes — must never reach a public repo.
CLAUDE.local.md

# Claude Code, personal to this machine
.claude/settings.local.json

# The CV PDF. Canonical copy is the Cloudinary raw asset written by
# `npm run cv:upload`; this is the local source it is uploaded from, and a
# few megabytes of scan-quality render does not belong in git history.
/docs/*.pdf
